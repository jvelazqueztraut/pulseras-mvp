{
  "name": "pulseras-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:web": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npx cap sync android",
    "cap:copy": "npx cap copy android",
